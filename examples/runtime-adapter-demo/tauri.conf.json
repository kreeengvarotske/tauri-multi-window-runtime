{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Runtime Adapter Demo",
  "version": "0.1.0",
  "identifier": "dev.tmwr.adapterdemo",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "Runtime adapter demo — main", "width": 640, "height": 480 }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'",
      "capabilities": ["default", "main"]
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/icon.ico"]
  }
}
