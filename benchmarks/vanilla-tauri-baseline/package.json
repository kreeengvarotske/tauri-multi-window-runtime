{
  "name": "vanilla-tauri-baseline",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "icons:generate": "tauri icon ./src-tauri/icons/vanilla-baseline.svg --output ./src-tauri/icons",
    "dev": "npm run icons:generate && vite",
    "build": "npm run icons:generate && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "test": "vitest run"
  },
  "dependencies": {
    "@tauri-apps/api": "^2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "jsdom": "^29.1.1",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.5"
  }
}