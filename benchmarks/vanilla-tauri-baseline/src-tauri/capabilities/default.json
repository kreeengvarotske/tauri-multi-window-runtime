{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Allows the baseline frontend to call its two read-only IPC commands",
  "windows": ["main", "secondary"],
  "permissions": [
    "core:default",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:event:allow-emit",
    "core:event:allow-emit-to",
    "allow-baseline-get-project-metadata",
    "allow-baseline-get-debug-stats"
  ]
}
